# Auto-detect text files and perform LF normalization
* text=auto

# Declare binary files explicitly so Git NEVER attempts line ending conversion
*.docx binary
*.doc binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.joblib binary
*.zip binary
*.pyc binary

# Explicit LF for source code and documentation
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf
LICENSE text eol=lf
.gitignore text eol=lf
.dockerignore text eol=lf
